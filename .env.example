# Environment Configuration
# Copy to .env and fill in values

# App
APP_NAME=money-factory
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./money_factory.db

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# arXiv
ARXIV_MAX_RESULTS=20
ARXIV_CATEGORIES=cs.AI,cs.CE,q-fin.TR

# RSS Feeds (comma-separated)
RSS_FEEDS=https://hnrss.org/frontpage,https://dev.to/feed,https://medium.com/feed/tag/technology

# Scoring weights
WEIGHT_NOVELTY=0.35
WEIGHT_FEASIBILITY=0.30
WEIGHT_MONETIZABILITY=0.35

# API
API_KEY_SECRET=change-me-in-production

# Cloudflare Worker
WORKER_URL=https://money-factory.blando-dz.workers.dev
CLOUDFLARE_ACCOUNT_ID=f1c8a6f07f198c1ce806dc731be21fb2
# CLOUDFLARE_API_TOKEN set via `wrangler secret put` or GitHub Secrets
